node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
.vercel

# Planilhas brutas do SINAPI: centenas de MB por UF/mês, republicadas
# mensalmente pela Caixa. Não versionar — o que vale é o importador.
data/sinapi/*
!data/sinapi/README.md

# Bytecode do importador em Python (scripts/sinapi/).
__pycache__/
*.pyc

# Config por máquina do skill impeccable (consentimento do hook local)
.impeccable/config.local.json

# Ferramentas de agente instaladas por máquina (skills, hooks, subagentes) —
# não são código do app, e é por isso que o `ignores` do eslint.config.js
# também as exclui. `.github/workflows` continua versionado: o CI é do projeto.
.claude/
.agents/
.codex/
.github/agents/
.github/hooks/
.github/skills/
